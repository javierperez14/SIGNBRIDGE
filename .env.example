# ==============================================================
# SignBridge — variables de entorno del stack (docker compose)
#
#   cp .env.example .env     y cambia los valores marcados
#
# El archivo .env NUNCA se sube al repo (está en .gitignore).
# ==============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=signbridge
POSTGRES_PORT=5432

# ── JWT ──────────────────────────────────────────────────────
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Correo (Mailtrap sandbox) ────────────────────────────────
# Cada integrante pone SUS credenciales de https://mailtrap.io
MAIL_USERNAME=tu_usuario_mailtrap
MAIL_PASSWORD=tu_password_mailtrap
MAIL_FROM=noreply@signbridge.com
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525

# ── App ──────────────────────────────────────────────────────
APP_NAME=Sign_Bridge
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
